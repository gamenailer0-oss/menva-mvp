# MENVA autoposter settings. install.sh copies this to .env and fills in what it can.
# After changing anything here, run:  docker compose up -d

# The web address of this server (see SETUP.md step 3). Examples:
#   social.yourdomain.net            (a subdomain you point at the server)
#   140-238-10-20.sslip.io           (free, no domain needed: the server IP with dashes)
DOMAIN=

# Email for the free HTTPS certificate (Let's Encrypt sends expiry warnings here)
ACME_EMAIL=

# Random secret that protects saved passwords inside n8n. install.sh generates it.
# Never change it after the first start, or n8n can't read its saved data.
N8N_ENCRYPTION_KEY=

# Instagram (SETUP.md step 5)
IG_ACCESS_TOKEN=
IG_USER_ID=
# Shown in the corner of every post, e.g. @menva.pk — leave empty to show nothing
IG_HANDLE=

# Post #1 goes out on this date (YYYY-MM-DD, Pakistan time). The whole 100-day calendar
# moves with it — seasonal posts stay near their season if you start within ~2 weeks.
START_DATE=2026-10-05
# Time of day posts go out (24h, Pakistan time)
POST_TIME=20:30

# true = make the image but don't post to Instagram (for the first test). Then set false.
DRY_RUN=true

# Optional: phone alerts through the free ntfy app. Pick a long random topic name,
# e.g. menva-7f3k9x2q, and subscribe to the same name in the app. Empty = no alerts.
NTFY_TOPIC=
